while True:
 print("\n\t\t\t\t\tEven And Odd Checker")
 def even():
    a=int(input("Enter a number to check its even.."))
    if a %2==0:
        print(f"This is a{a}even number.")
    else:
       print("This is not a even number..")

 def odd():
    a=int(input("Ente a number to check its odd.."))
    if a %2!=0:
        print(f"This is a{a}odd number.")
    else:
       print("This is not a odd nummber..")

 print("\n\t\t\t\t\tMENU")
 print("1.Even Checker:")
 print("2.Odd Checker:")
