# Project 5
def Cel_to_Fahren():
    c = float(input("Enter a temperature to convert Celsius to Fahrenheit: "))
    f = (c * 9/5) + 32
    print("Celsius to Fahrenheit:", f)


def Fahren_to_Cel():
    f = float(input("Enter a temperature to convert Fahrenheit to Celsius: "))
    c = (f - 32) * 5/9
    print("Fahrenheit to Celsius:", c)


while True:
    print("\n\t\t\t\t\tTEMPERATURE CONVERTER")
    print("MENU")
    print("1. CELSIUS TO FAHRENHEIT")
    print("2. FAHRENHEIT TO CELSIUS")
    print("3. EXIT")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        print("1. CELSIUS TO FAHRENHEIT")
        Cel_to_Fahren()

    elif choice == 2:
        print("2. FAHRENHEIT TO CELSIUS")
        Fahren_to_Cel()

    elif choice == 3:
        print("3. EXIT")
        print("EXIT PROGRAM..")
        break